# Supabase Project Settings → API. Use the anon/publishable key, NEVER service_role.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Shared Naver credentials configured by the service owner (optional).
NAVER_MAP_KEY=
# NAVER API HUB → NAVER 검색 → 지역 (Maps와 별도 앱)
NAVER_SEARCH_ID=
NAVER_SEARCH_SECRET=

# VWorld 2D Data API: road-address building footprints + detailed dong names.
# Server-only key. Register the deployed service URL in VWorld.
VWORLD_API_KEY=
VWORLD_DOMAIN=https://zipzip-mu.vercel.app
